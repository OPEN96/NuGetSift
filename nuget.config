<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      NuGetSift 构建只依赖 nuget.org 上的公开包（Avalonia 等）。
      这里的 <clear/> 保证还原结果可复现，不受开发者本机全局源影响。

      运行时连接的「私有 NuGet 源」是通过 config.json 里的 BaGet.BaseUrl 配置的，
      与此处无关，不需要登记为 NuGet 还原源。

      若你的组织需要从内网源还原依赖，可自行取消下面这行注释：
      <add key="Corporate" value="https://your-feed/v3/index.json" />
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
